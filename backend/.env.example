# Copy to backend/.env. Without it the API uses a local SQLite file (backend/expenses.db).
# Postgres from docker-compose.yml at the repo root:
DATABASE_URL=postgresql+psycopg://amex:amex@localhost:5432/amex
CORS_ORIGINS=["http://localhost:5173"]

# Supabase Auth (Project Settings -> API). The URL is enough for projects using
# JWT signing keys; projects on the legacy shared secret also set the secret.
SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_SECRET=
